generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

model OpenApiSpec {
  id        String     @id @default(uuid())
  name      String
  filePath  String
  content   String
  createdAt DateTime   @default(now())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id])
  endpoints Endpoint[]
}

model Endpoint {
  id         String     @id @default(uuid())
  path       String
  method     String
  summary    String?
  responses  Json?
  specId     String
  spec       OpenApiSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  scenarios  Scenario[]

  @@unique([specId, path, method])
}

model User {
  id             Int           @id @default(autoincrement())
  name           String
  email          String        @unique
  password       String?
  createdAt      DateTime      @default(now())
  specifications OpenApiSpec[]
  passwordResets PasswordReset[]
  keycloakId     String?       @unique 
}

model Scenario {
  id             String   @id @default(uuid())
  statusCode     Int
  description    String?
  name           String?
  isDefault      Boolean  @default(false)
  mockContent    String?
  contentType    String?
  headers        Json?
  requestExample Json?
  requestExampleIsAuto Boolean @default(true)
  mockContentIsAuto Boolean @default(true)
  delayMs        Int      @default(0)
  endpointId     String
  endpoint       Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}


model FieldSuggestion {
  id        String   @id @default(cuid())
  fieldKey  String   @unique
  fieldName String
  fieldType String
  value     Json
  source    String   @default("gemini")
  createdAt DateTime @default(now())
}


model PasswordReset {
  id         String   @id @default(uuid())
  userId     Int
  purpose    String   @default("password_reset")
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}