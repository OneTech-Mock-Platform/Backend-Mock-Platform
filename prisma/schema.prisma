generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
}

model OpenApiSpec {
  id        String     @id @default(uuid())
  name      String
  filePath  String
  content   String
  createdAt DateTime   @default(now())
  userId    Int?
  user      User?      @relation(fields: [userId], references: [id])
  endpoints Endpoint[]
}

model Endpoint {
  id         String     @id @default(uuid())
  path       String
  method     String
  summary    String?
  responses  Json?
  specId     String
  spec       OpenApiSpec @relation(fields: [specId], references: [id], onDelete: Cascade)
  scenarios  Scenario[]
}

model User {
  id             Int           @id @default(autoincrement())
  name           String
  email          String        @unique
  password       String
  createdAt      DateTime      @default(now())
  specifications OpenApiSpec[]
  passwordResets PasswordReset[]
}

model Scenario {
  id          String   @id @default(uuid())
  statusCode  Int
  description String?
  endpointId  String
  endpoint    Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
}

model PasswordReset {
  id         String   @id @default(uuid())
  userId     Int
  otpHash    String
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
